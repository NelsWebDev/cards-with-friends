// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgres"
}

// Deck manager accounts. Separate from game players (User / GameUser).
model Account {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String?          @map("password_hash")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  decks        Deck[]
  sessions     AccountSession[]

  @@map("users")
}

model AccountSession {
  tokenHash String   @id @map("token_hash")
  accountId String   @map("account_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("users_sessions")
}

model BlackCard {
  id         String          @id @default(cuid())
  text       String          @db.Text
  pick       Int
  deletedAt  DateTime?       @map("deleted_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  decksCards DeckBlackCard[]

  @@map("black_cards")
}

model WhiteCard {
  id         String          @id @default(cuid())
  text       String          @db.Text
  deletedAt  DateTime?       @map("deleted_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  decksCards DeckWhiteCard[]

  @@map("white_cards")
}

model Deck {
  id             String   @id @default(cuid())
  name           String   @db.Text
  description    String?  @db.Text
  importedDeckId String?  @map("imported_deck_id")
  cahOfficial    Boolean  @default(false) @map("cah_official")
  // Informational only: any account can edit or delete any non-official deck.
  createdById    String?  @map("created_by_id")
  createdBy      Account? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  deletedAt  DateTime?       @map("deleted_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  blackCards DeckBlackCard[]
  whiteCards DeckWhiteCard[]

  @@map("decks")
}

model DeckBlackCard {
  deckId      String    @map("deck_id")
  blackCardId String    @map("black_card_id")
  deck        Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  blackCard   BlackCard @relation(fields: [blackCardId], references: [id], onDelete: Cascade)

  @@id([deckId, blackCardId])
  @@map("decks_black_cards")
}

model DeckWhiteCard {
  deckId      String    @map("deck_id")
  whiteCardId String    @map("white_card_id")
  deck        Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  whiteCard   WhiteCard @relation(fields: [whiteCardId], references: [id], onDelete: Cascade)

  @@id([deckId, whiteCardId])
  @@map("decks_white_cards")
}
